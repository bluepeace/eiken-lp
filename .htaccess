# AiKen LP - レンサバ用
# ディレクトリインデックスを index.php に
DirectoryIndex index.php

# 可能なら .php なしでアクセス（例: / → index.php、/1kyu/ → grade.php?level=1kyu）
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # キャッシュ直アクセス防止
  RewriteRule ^cache/ - [F,L]
  # 実在ファイル・ディレクトリはそのまま
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # サイトマップ（sitemap.xml → sitemap.php）
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  # 静的ページ
  RewriteRule ^about/?$ about.php [L,QSA]
  RewriteRule ^faq/?$ faq.php [L,QSA]
  RewriteRule ^plan/?$ plan.php [L,QSA]
  RewriteRule ^tokushoho/?$ tokushoho.php [L,QSA]
  RewriteRule ^terms/?$ terms.php [L,QSA]
  RewriteRule ^privacy/?$ privacy.php [L,QSA]
  RewriteRule ^contact/?$ contact.php [L,QSA]
  RewriteRule ^external-transmission/?$ external-transmission.php [L,QSA]
  RewriteRule ^company/?$ company.php [L,QSA]
  RewriteRule ^cancel/?$ cancel.php [L,QSA]
  RewriteRule ^parents/?$ parents.php [L,QSA]
  RewriteRule ^guide/?$ guide.php [L,QSA]
  # 級別入り口ページ
  RewriteRule ^(1kyu|jun1kyu|2kyu|jun2kyu-plus|jun2kyu|3kyu|4kyu|5kyu)/?$ grade.php?level=$1 [L,QSA]
  # トップは index.php
  RewriteRule ^$ index.php [L]
</IfModule>

# セキュリティ: 設定・include 直アクセス防止（任意）
<FilesMatch "^(config|\.htaccess)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
